# --- Discord Interactions エンドポイント（Vercel 環境変数に設定）---
# Developer Portal > General Information > Public Key
DISCORD_PUBLIC_KEY=

# --- コマンド登録 / sync 用（ローカルのみ）---
# Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=
# Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=
# テスト時に即時反映したいギルド(サーバー)ID。空ならグローバル登録。
DISCORD_GUILD_ID=

# --- TOTP シークレット ---
# `uv run sync` が config.toml と secrets/ の QR から自動生成する。
# 手動で入れる場合の例:
# TOTP_SECRET_GOOGLE=BASE32SECRET...
# TOTP_SECRET_GITHUB=BASE32SECRET...
